FW_VER=1.6.2

MODULE_NAME := ipu-module
OUT := $(MODULE_NAME)

DIR=$(KERNEL_VERSION)/ipu/a1

ccflags-y += -I$(src)/$(DIR)/include

SRCS := $(DIR)/ipu-module.c \
	$(DIR)/private-funcs.c


OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)
OBJS += sdk/$(SOC_FAMILY)/libipu-firmware-$(FW_VER)-720-4494.a

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o
