MODULE_NAME := tx-isp-$(SOC_FAMILY)

OUT := $(MODULE_NAME)

# Source set selection.
#  - t41 is shared between kernels and lives in common/isp/t41.
#  - t31 on 4.4.94 uses the standalone shim implementation at 4.4.94/isp/t31.
#  - the remaining SoCs are single-kernel and stay under their tree.
ifeq ($(SOC_FAMILY),t41)
ISP_DIR := common/isp/t41
else
ISP_DIR := 4.4.94/isp/$(SOC_FAMILY)
endif

DIR := $(ISP_DIR)

ccflags-y += -I$(src)/include

include $(src)/$(ISP_DIR)/Kbuild
