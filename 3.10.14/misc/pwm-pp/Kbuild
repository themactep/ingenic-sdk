# 3.10.14 PP/TCU based PWM driver. A different implementation from the
# 4.4.94 PWM driver (tcu_alloc arbitration, runtime channel selection),
# hence a separate source set. Built modules stay pwm_core/pwm_hal so the
# /dev/pwm ABI is unaffected.
DIR := $(KERNEL_VERSION)/misc

PWM_CORE_MODULE := pwm_core
OBJS1 := $(DIR)/pwm-pp/pwm_core.o

PWM_HAL_MODULE := pwm_hal
OBJS2 := $(DIR)/pwm-pp/pwm_hal.o

obj-m += $(PWM_CORE_MODULE).o
obj-m += $(PWM_HAL_MODULE).o

$(PWM_CORE_MODULE)-objs := $(OBJS1)
$(PWM_HAL_MODULE)-objs := $(OBJS2)

# Definitions
DEFS =
DEFS += -DCONFIG_PWM0
DEFS += -DCONFIG_PWM1
# NOTE: leave PWM2 disabled to avoid conflict with motor driver (uses tcu_chn2)
#DEFS += -DCONFIG_PWM2
DEFS += -DCONFIG_PWM3
#DEFS += -DCONFIG_PWM4
#DEFS += -DCONFIG_PWM5
#DEFS += -DCONFIG_PWM6
#DEFS += -DCONFIG_PWM7

EXTRA_CFLAGS += $(DEFS)
