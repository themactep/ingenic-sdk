# 3.10.14 PP/TCU-based motor driver. Totally different implementation from the
# 4.4.94 GPIO/TCU motor driver, hence a separate source set. The built module is
# still named "motor" so userspace (S59motor) and the /dev/motor ABI are
# unaffected.
MODULE_NAME := motor

OUT := $(MODULE_NAME)

DIR := $(KERNEL_VERSION)/misc/motors-pp

SRCS := $(DIR)/motor.c

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o
