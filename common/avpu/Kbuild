# Merged AVPU driver. One source set now serves every supported SoC and both
# kernels; per-SoC / per-kernel differences are handled in the sources via
# CONFIG_SOC_* and CONFIG_KERNEL_* guards.
MODULE_NAME := avpu
OUT := $(MODULE_NAME)

DIR := common/avpu

AVPU_NO_DMABUF ?= 0

SRCS := \
  $(DIR)/avpu_main.c \
  $(DIR)/avpu_ip.c \
  $(DIR)/avpu_alloc.c \
  $(DIR)/avpu_alloc_ioctl.c

ifeq ($(AVPU_NO_DMABUF),1)
SRCS += \
  $(DIR)/avpu_no_dmabuf.c
else
SRCS += \
  $(DIR)/avpu_dmabuf.c
endif

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o
