# t41 ISP driver. One source set serves both kernels; the only build-level
# difference is which prebuilt firmware blob is linked.
ifeq ($(KERNEL_VERSION),3.10.14)
ISP_FW_FILE := lib$(SOC_FAMILY)-firmware-1.2.0-3-10-14.a
else
ISP_FW_FILE := lib$(SOC_FAMILY)-firmware-1.2.6.a
ldflags-y += --no-warn-mismatch
endif

SRCS := $(DIR)/tx-isp-funcs.c \
	$(DIR)/tx-isp-module.c

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)
OBJS += sdk/$(SOC_FAMILY)/$(ISP_FW_FILE)

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o
